# =============================================================================
# LIKEMM — configuration Apache (hebergement statique type LWS / OVH / cPanel)
# Ce fichier est copie tel quel dans dist/ par Vite. Il doit se trouver a la
# racine du dossier publie.
# =============================================================================

# --- 1. HTTPS obligatoire ----------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (ne rien changer si le proxy de l'hebergeur le fait deja)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- 2. Routing SPA --------------------------------------------------------
  # Indispensable pour les deep links : /@alex, /legal, /settings, /admin...
  # Un rafraichissement direct sur /@alex doit servir index.html, pas un 404.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- 3. En-tetes de securite -------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Content-Security-Policy
  # IMPORTANT : remplacer https://VOTRE-PROJET.supabase.co par l'URL reelle du
  # projet Supabase (voir docs/DEPLOY.md). Les domaines de mesure d'audience et
  # de publicite ne doivent etre ajoutes que lorsqu'ils sont reellement
  # utilises, et le chargement des scripts reste conditionne au consentement.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://VOTRE-PROJET.supabase.co; font-src 'self' data:; connect-src 'self' https://VOTRE-PROJET.supabase.co wss://VOTRE-PROJET.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # Cache long pour les assets fingerprintes, aucun cache pour index.html
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# --- 4. Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- 5. Ne pas exposer les fichiers sensibles --------------------------------
<FilesMatch "(^\.env|\.env\..*|^\.git|package(-lock)?\.json|\.map)$">
  Require all denied
</FilesMatch>

ErrorDocument 404 /index.html
