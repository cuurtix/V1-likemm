# =============================================================================
# LIKEMM — variables d'environnement
# Copier ce fichier en `.env` et completer. NE JAMAIS committer `.env`.
# Seules les variables prefixees VITE_ sont exposees au navigateur : ne mettre
# ICI QUE des valeurs publiques.
# =============================================================================

# URL du projet Supabase (publique)
VITE_SUPABASE_URL=

# Cle "anon" / "publishable" de Supabase (publique, protegee par les RLS)
VITE_SUPABASE_ANON_KEY=

# Origine publique du site, utilisee pour construire les liens de partage
VITE_SITE_URL=https://likemm.site

# Adresse de contact affichee dans les pages legales
VITE_CONTACT_EMAIL=help@likemm.site

# Version des documents juridiques enregistree avec les consentements
VITE_POLICY_VERSION=2026-09-12

# Mesure d'audience — laisser vide tant que la propriete n'est pas creee.
# Le script n'est charge QU'APRES consentement analytics de l'utilisateur.
VITE_GA_MEASUREMENT_ID=

# Pixels publicitaires — laisser vide. Charges uniquement apres consentement
# publicitaire ET si l'utilisateur n'est pas mineur.
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# ---------------------------------------------------------------------------
# NE JAMAIS placer ici : la cle de service Supabase (celle qui contourne les
# regles de securite), le secret de signature des jetons, les mots de passe de
# la base, ou toute cle d'API privee. Elles n'ont RIEN a faire dans un build
# frontend, qui est integralement lisible par n'importe quel visiteur.
#
# Le script `npm run audit:mock` echoue si l'une d'elles apparait quelque part
# dans le projet.
# ---------------------------------------------------------------------------
